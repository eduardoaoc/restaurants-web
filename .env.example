VITE_API_URL=http://localhost:8080

# Laravel Reverb (Passo 1.3). REVERB_APP_KEY is the public app key every
# client presents to Reverb — never the server-only REVERB_APP_SECRET
# (that one lives only in restaurants-api's own .env and the frontend
# never needs it). Match these to the backend's config/reverb.php /
# .env for whichever environment you're pointing at.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=

# Base URL of the customer-facing (QR) experience — Passo 2.7. Each table's
# QR encodes `${VITE_PUBLIC_APP_URL}/t/{public_token}`. Intentionally EMPTY
# by default: that customer route does not exist yet, and a QR must never
# encode a link that would 404 for a real diner. While this is unset, the
# Mesas screen shows the QR section as "not published yet" instead of
# rendering a fake code. Never commit a production domain here.
VITE_PUBLIC_APP_URL=
