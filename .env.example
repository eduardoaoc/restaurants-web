VITE_API_URL=http://localhost:8080

# Laravel Reverb (Passo 1.3). REVERB_APP_KEY is the public app key every
# client presents to Reverb — never the server-only REVERB_APP_SECRET
# (that one lives only in restaurants-api's own .env and the frontend
# never needs it). Match these to the backend's config/reverb.php /
# .env for whichever environment you're pointing at.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
