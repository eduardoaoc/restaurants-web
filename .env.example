# All VITE_* values are PUBLIC and embedded in the bundle. NEVER add secrets.
# Local: npm run dev / npm run build use mode development (target local) and accept localhost/HTTP.
# Vite loads .env then optional .env.local. Empty public origin disables QR.
VITE_API_URL=http://localhost:8080
# Existing customer route: /t/:publicToken
VITE_PUBLIC_APP_URL=
# Optional realtime: leave ALL four empty to disable. Public key, never server secret.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=

# npm run build:staging (.env.staging) / build:production (.env.production):
# Both require HTTPS origins and reject localhost/loopback.
# Origins reject paths, credentials, queries and fragments in all modes.
# Safe examples only; never commit real deployment values.
# VITE_API_URL=https://api.staging.example
# VITE_PUBLIC_APP_URL=https://app.staging.example
# Production: https://api.production.example / https://app.production.example
# If ANY realtime value is set in staging/production, ALL are required:
# VITE_REVERB_APP_KEY=public-example-key
# VITE_REVERB_HOST=ws.staging.example
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
# https selects WSS only. Select matching environment origins explicitly.

# Target comes only from Vite MODE, never command=build or import.meta.env.PROD.
# Unknown modes fail validation; development is the local target.
# Vite reserves the name local for its .env.local postfix.
