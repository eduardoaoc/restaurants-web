# AFORO web — STAGING build values. Copy to .env.staging (git-ignored) on the
# build machine and run: npm ci && npm run build:staging
# Every VITE_* value is PUBLIC (embedded in the JS bundle): never a secret.
# The build refuses http, localhost/loopback, paths, queries and partial
# realtime settings (src/config/env.ts). Runbook: restaurants-api/docs/staging-runbook.md.

# API origin (scheme + host, no path) = APP_URL of the API.
VITE_API_URL=https://api-staging.conejocreative.com
# Public origin of THIS SPA (table QR links /t/:token are built from it)
# = AFORO_WEB_URL of the API.
VITE_PUBLIC_APP_URL=https://CHANGE_ME_WEB_HOST

# Realtime (all four or none). Key = REVERB_APP_KEY of the staging API (public);
# never REVERB_APP_SECRET. Same host as the API: nginx proxies /app to Reverb.
VITE_REVERB_APP_KEY=CHANGE_ME_REVERB_APP_KEY
VITE_REVERB_HOST=api-staging.conejocreative.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
